# ==========================================
# OWN HEALTH - ENVIRONMENT CONFIGURATION
# ==========================================

# Next.js App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Configuration (SQLite by default for zero-friction setup, or PostgreSQL / Supabase)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL / Supabase:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres?schema=public"

# Authentication & Security
JWT_SECRET="ownhealth-super-secure-jwt-secret-key-32charsmin!"
DEMO_OTP="123456" # For instant demo verification on any phone number

# LLM Providers (OpenAI GPT-4o, Anthropic Claude, or Google Gemini)
# If left empty, Own Health utilizes its high-precision built-in clinical analysis engine
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# IPFS Decentralized Storage (Pinata / Public Gateways)
PINATA_API_KEY=""
PINATA_API_SECRET=""
PINATA_JWT=""
NEXT_PUBLIC_IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs"

# Web3 - Ethereum Sepolia Testnet
# Smart Contract: OwnHealthRegistry (stores bytes32 patientHash, string ipfsCid, uint256 timestamp)
SEPOLIA_RPC_URL="https://rpc.sepolia.org"
SEPOLIA_PRIVATE_KEY=""
SEPOLIA_CONTRACT_ADDRESS="0x742d35Cc6634C0532925a3b844Bc454e4438f44e" # Deployed OwnHealth registry contract

# Web3 - Stellar Testnet (Health Score & Verification Memo Logging)
STELLAR_HORIZON_URL="https://horizon-testnet.stellar.org"
STELLAR_SECRET_KEY=""
STELLAR_PUBLIC_KEY=""

# External Communications - Twilio WhatsApp Business API / Meta WhatsApp Cloud API
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886" # Twilio WhatsApp sandbox number
DOCTOR_WHATSAPP_NUMBER="+15550198234" # Recipient Doctor's WhatsApp number for triage alerts
